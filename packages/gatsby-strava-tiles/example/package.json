{
  "name": "gatsby-source-strava-example",
  "private": true,
  "scripts": {
    "build": "NODE_OPTIONS=--no-deprecation gatsby build",
    "clean": "gatsby clean",
    "dev": "NODE_OPTIONS=--no-deprecation gatsby develop -p 8109",
    "serve": "NODE_OPTIONS=--no-deprecation gatsby serve -p 8109",
    "strava-token": "../../gatsby-source-strava/scripts/token.js",
    "fetch-activity": "../../gatsby-source-strava/scripts/activity.js --streams latlng",
    "sync-activities": "../../gatsby-source-strava/scripts/activities.js"
  },
  "dependencies": {
    "@urbica/react-map-gl": "^1.16.2",
    "dotenv": "^8.2.0",
    "gatsby": "5.14.0",
    "mapbox-gl": "^3.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.32.6"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "eslint-plugin-react": "^7.37.2",
    "prettier": "3.4.1"
  },
  "allowScripts": {
    "sharp": true,
    "lmdb": false,
    "@parcel/watcher": false,
    "core-js": false,
    "core-js-pure": false,
    "es5-ext": false,
    "gatsby": false,
    "gatsby-cli": false,
    "msgpackr-extract": false,
    "fsevents": false
  }
}
