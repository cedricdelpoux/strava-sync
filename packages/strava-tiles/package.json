{
  "name": "strava-tiles",
  "version": "0.1.1",
  "description": "Compute the map tiles covered by your Strava activities, and draw them as images",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedricdelpoux/strava-sync.git",
    "directory": "packages/strava-tiles"
  },
  "homepage": "https://github.com/cedricdelpoux/strava-sync/tree/main/packages/strava-tiles#readme",
  "bugs": {
    "url": "https://github.com/cedricdelpoux/strava-sync/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/cedricdelpoux"
    },
    {
      "type": "ko-fi",
      "url": "https://ko-fi.com/cedricdelpoux"
    },
    {
      "type": "thanks.dev",
      "url": "https://thanks.dev/u/gh/cedricdelpoux"
    },
    {
      "type": "paypal",
      "url": "https://paypal.me/cedricdelpoux"
    }
  ],
  "author": "Cédric Delpoux <cedric.delpoux@gmail.com>",
  "license": "MIT",
  "keywords": [
    "strava",
    "tiles",
    "map",
    "activities",
    "explorer"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    },
    "./images": {
      "types": "./types/images.d.ts",
      "default": "./images.js"
    },
    "./map": {
      "types": "./types/map.d.ts",
      "default": "./map.js"
    },
    "./tiles": {
      "types": "./types/tiles.d.ts",
      "default": "./tiles.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "images.js",
    "map.js",
    "tiles.js",
    "bin",
    "lib",
    "types"
  ],
  "bin": {
    "strava-tiles": "bin/strava-tiles.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "strava-sync": "^0.1.1"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  },
  "peerDependencies": {
    "sharp": ">=0.32.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run --coverage",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm test"
  }
}
